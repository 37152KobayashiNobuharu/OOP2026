<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報アプリ"
        Height="700"
        Width="800"
        Background="#EAF6FF">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="15"
                Padding="20">

            <StackPanel>

                <TextBlock Text="🌤 天気予報アプリ"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <ComboBox x:Name="CityComboBox"
                          Width="200"
                          Height="30"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"
                          SelectionChanged="CityComboBox_SelectionChanged"/>

                <TextBlock Text="現在の天気"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="TemperatureText"
                           Text="--℃"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="WeatherTextBlock"
                           FontSize="28"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <TextBlock Text="7日間予報"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,10,0,10"/>

                <ListView x:Name="ForecastListView"
                          Height="300">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="日付"
                                            Width="120"
                                            DisplayMemberBinding="{Binding Date}" />

                            <GridViewColumn Header="天気"
                                            Width="120"
                                            DisplayMemberBinding="{Binding WeatherText}" />

                            <GridViewColumn Header="最高気温(℃)"
                                            Width="120"
                                            DisplayMemberBinding="{Binding MaxTemperature}" />

                            <GridViewColumn Header="最低気温(℃)"
                                            Width="120"
                                            DisplayMemberBinding="{Binding MinTemperature}" />

                            <GridViewColumn Header="降水確率(%)"
                                            Width="120"
                                            DisplayMemberBinding="{Binding PrecipitationProbability}" />

                        </GridView>
                    </ListView.View>

                </ListView>

            </StackPanel>

        </Border>

    </Grid>
</Window>